# Copy this file to .env and fill in your values
# cp .env.example .env

# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Absolute path to your UPSC study material (PDFs, notes)
UPSC_CONTENT_PATH=/path/to/your/upsc/content

# Absolute path to this project root
PROJECT_PATH=/path/to/this/repo

# ChromaDB vector store (auto-created on first ingest)
CHROMA_PATH=/path/to/this/repo/vector_store

# SQLite DB path
DB_PATH=/path/to/this/repo/data/upsc.db

# Server config (defaults work fine)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Model selection — these are the recommended defaults
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SMART=claude-sonnet-4-6

# Per-caller service credentials for the internal API (/internal/v1/*), one key per
# consumer (PLAN-008 §4 — generalized from a single shared ARENA_SERVICE_API_KEY once
# Scribe's RBI feature became a second internal caller, not just Arena).
# Generate each with `openssl rand -hex 32`. NEEDS RAHUL'S EXPLICIT APPROVAL BEFORE
# MERGE — see the approval note at the top of backend/routes/internal_arena.py.
#
# Give the Arena value to Arena's backend config as RECALL_API_KEY.
INTERNAL_API_KEY_ARENA=
# Give this value to Scribe's config once its RBI cutover (PLAN-008 §3) is built.
INTERNAL_API_KEY_SCRIBE_RBI=
